# Copy to platform/deploy/.env.production on the server (never commit it) and chmod 600.
# Keep comments on their own lines: Docker env files treat text after "=" as the value, comments included.

SITE_DOMAIN=solluna.co.in
ACME_EMAIL=solluna.play@gmail.com
# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32 — keep an offline copy; losing it locks 2FA seeds
DATA_ENCRYPTION_KEY=
APP_URL=https://solluna.co.in
REQUIRE_ADMIN_2FA=true
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=5
SWEEP_INTERVAL_MS=3600000

# Razorpay — leave EMPTY until KYC is complete. Checkout then shows "payments not configured"; nothing is simulated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SUPPLIER_LEGAL_NAME=Aaditya Jitendrabhai Sorathia
SUPPLIER_TRADE_NAME=Solluna
SUPPLIER_GSTIN=24OPVPS8924H1ZQ
SUPPLIER_ADDRESS=Survey No 135, Plot No 9, Shreeji Nagar, Meghpar Kumbhardi Sim, Anjar, Kachchh, Gujarat 370110
SUPPLIER_EMAIL=solluna.play@gmail.com
GST_RATE_BPS=1800
INVOICE_SAC=998399

# Zapier Catch Hook → Gmail (password reset, verification, notifications). Empty = in-app notifications only.
CONNECTOR_WEBHOOK_URL=
CONNECTOR_WEBHOOK_SECRET=

# First super admin — used once by the seed; enrols 2FA at first sign-in. 16+ characters.
ADMIN_EMAIL=solluna.play@gmail.com
ADMIN_PASSWORD=

# Product lookup for the listing forms (Claude web search). Empty = clients fill product details manually.
ANTHROPIC_API_KEY=
# LOOKUP_MODEL=claude-haiku-5-5
# LOOKUP_DAILY_LIMIT=25

# Seller-portal access: the SOLLUNA user clients add in Seller Central / Seller Hub (see docs/plans/SELLER_PORTAL_AUTOMATION.md)
OPS_USER_ROLE=Admin
OPS_USER_NAME=SOLLUNA Operations
OPS_USER_EMAIL=ops@solluna.co.in
# Shared secret for the Cloudflare ops-mail Worker (same value as the Worker secret OPS_MAIL_SECRET; at least 24 characters)
OPS_MAIL_INBOUND_SECRET=
OPS_USER_PHONE=

# Monthly report cycle: marketplace reports on the 5th, client report ready by the 7th (REPORT_CYCLE=off disables the automatic run)
REPORT_MARKETPLACE_DAY=5
REPORT_READY_DAY=7

# Client manager agent (Manager Chat). On when ANTHROPIC_API_KEY is set; MANAGER_AGENT=off disables it.
MANAGER_AGENT_MODEL=claude-haiku-5-5
AGENT_REPLY_DELAY_SEC=15
AGENT_HUMAN_QUIET_MIN=30
USD_INR=88
AGENT_HISTORY=16
AGENT_DIGEST_AFTER=24

# Amazon SP-API (official). App credentials from Seller Central → Develop Apps; refresh token from "Authorize" (test seller)
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_TEST_REFRESH_TOKEN=
