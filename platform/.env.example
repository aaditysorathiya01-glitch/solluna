# ── API (apps/api) ──
DATABASE_URL=postgresql://solluna:solluna@localhost:5432/solluna
JWT_SECRET=                      # 32+ random chars
JWT_TTL=12h
COOKIE_SECURE=true               # false only for local http
PORT=4000
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=5        # login/register attempts per IP per minute

# Razorpay (Dashboard → Settings → API Keys / Webhooks). Webhook URL: https://<domain>/api/billing/webhook/razorpay
# Events: payment.captured, order.paid, payment.failed
RAZORPAY_KEY_ID=                 # TEST mode (rzp_test_…) until Razorpay KYC is complete
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# GST tax invoices (prices are GST-exclusive; checkout is refused until these are set)
SUPPLIER_LEGAL_NAME=Aaditya Jitendrabhai Sorathia   # GST REG-06, Proprietorship
SUPPLIER_TRADE_NAME=Solluna
SUPPLIER_GSTIN=24OPVPS8924H1ZQ   # Gujarat (24): Gujarat buyers CGST+SGST, others IGST
SUPPLIER_ADDRESS=Survey No 135, Plot No 9, Shreeji Nagar, Meghpar Kumbhardi Sim, Anjar, Kachchh, Gujarat 370110
SUPPLIER_EMAIL=solluna.play@gmail.com
GST_RATE_BPS=1800
INVOICE_SAC=998399               # confirm with your CA

GRACE_DAYS=3
RENEWAL_REMINDER_DAYS=3
SWEEP_INTERVAL_MS=3600000        # renewal/grace/past-due sweep; 0 disables

# Connectors (docs/connectors.md). Zapier "Catch Hook" URL → Gmail / Google Sheets fan-out.
CONNECTOR_WEBHOOK_URL=
CONNECTOR_WEBHOOK_SECRET=        # sent as x-solluna-signature (HMAC-SHA256 of body)
APPROVED_OUTPUT_HOSTS=drive.google.com,docs.google.com

# Security
DATA_ENCRYPTION_KEY=             # 32+ random chars; encrypts TOTP seeds at rest (falls back to JWT_SECRET — set it in production)
REQUIRE_ADMIN_2FA=true           # super admins must enrol TOTP before the console opens
APP_URL=https://solluna.co.in    # base for emailed links (password reset, email verification)
EXPOSE_AUTH_LINKS=false          # DEV/PREVIEW ONLY: show emailed links on screen when no email connector is set

# Seed (first super admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Web (apps/web) ──
API_URL=http://localhost:4000    # read at runtime by the /api proxy route
