# ── API (apps/api) ──
DATABASE_URL=postgresql://solluna:solluna@localhost:5432/solluna
JWT_SECRET=                      # 32+ random chars
JWT_TTL=12h
COOKIE_SECURE=true               # false only for local http
PORT=4000
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=5        # login/register attempts per IP per minute

# Razorpay (Dashboard → Settings → API Keys / Webhooks). Webhook URL: https://<domain>/api/billing/webhook/razorpay
# Events: payment.captured, order.paid, payment.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GRACE_DAYS=3
RENEWAL_REMINDER_DAYS=3
SWEEP_INTERVAL_MS=3600000        # renewal/grace/past-due sweep; 0 disables

# Connectors (docs/connectors.md). Zapier "Catch Hook" URL → Gmail / Google Sheets fan-out.
CONNECTOR_WEBHOOK_URL=
CONNECTOR_WEBHOOK_SECRET=        # sent as x-solluna-signature (HMAC-SHA256 of body)
APPROVED_OUTPUT_HOSTS=drive.google.com,docs.google.com

# Seed (first super admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Web (apps/web) ──
API_URL=http://localhost:4000    # read at runtime by the /api proxy route
