// SOLLUNA 2.0 — core schema. Every tenant-owned model carries organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────

enum UserType {
  CUSTOMER
  STAFF
}

enum StaffRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  LISTING_EXECUTIVE
  ADS_MANAGER
  SUPPORT_EXECUTIVE
  ACCOUNTS_EXECUTIVE
}

enum Marketplace {
  AMAZON
  FLIPKART
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  GRACE_PERIOD
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  INITIATED
  VERIFIED
  FAILED
  REFUNDED
}

enum ListingStatus {
  RESEARCH_NOT_STARTED
  EXISTING_ID_CHECK
  EXISTING_ID_FOUND
  NEW_CATALOG_CANDIDATE
  ELIGIBILITY_CHECK
  BRAND_APPROVAL_REQUIRED
  APPROVAL_REQUIRED
  DOCUMENTS_PENDING
  CONTENT_IN_PROGRESS
  CONTENT_REVIEW
  CLIENT_APPROVAL_PENDING
  APPROVED_FOR_SUBMISSION
  SUBMITTED
  PROCESSING
  PROCESSING_ERROR
  CATALOG_ID_CREATED
  LISTING_INCOMPLETE
  SUPPRESSED
  ACTIVE
  INACTIVE
  REJECTED
  BLOCKED
  CANCELLED
}

enum MappingStatus {
  NOT_ASSESSED
  EXACT_VERIFIED
  HIGH_CONFIDENCE
  REVIEW_REQUIRED
  NO_MATCH_FOUND
  CONFLICT
  NOT_ELIGIBLE_OR_BLOCKED
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CLIENT
  WAITING_FOR_MARKETPLACE
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ACCOUNT_REGISTRATION
  BRAND_APPROVAL
  CATALOG_MAPPING
  NEW_LISTING
  ADS
  PROMOTIONS
  INVENTORY
  SHIPPING_LABELS
  PAYMENTS_SETTLEMENTS
  ACCOUNT_HEALTH
}

enum LabelJobStatus {
  QUEUED
  PROCESSING
  READY
  DELIVERED
  FAILED
}

enum FigureConfidence {
  VERIFIED
  ESTIMATED
  UNAVAILABLE
}

enum TaskStatus {
  NEW
  AWAITING_INFORMATION
  AWAITING_CLIENT_APPROVAL
  PLAN_VERIFICATION
  QUEUED
  IN_PROGRESS
  BLOCKED
  UNDER_MARKETPLACE_REVIEW
  COMPLETED
  PARTIALLY_COMPLETED
  CANCELLED
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum PromotionStatus {
  OPPORTUNITY_IDENTIFIED
  ELIGIBILITY_CHECK
  ECONOMICS_PENDING
  PROPOSAL_PREPARED
  CLIENT_APPROVAL_REQUIRED
  CLIENT_APPROVED
  SUBMITTED
  MARKETPLACE_UNDER_REVIEW
  APPROVED
  SCHEDULED
  ACTIVE
  REJECTED
  OPT_OUT_REQUESTED
  OPT_OUT_PENDING
  OPTED_OUT
  EXPIRED
  RECONCILIATION_REQUIRED
  CLOSED
}

enum StockSeverity {
  CRITICAL
  HIGH
  MEDIUM
  WATCH
  HEALTHY
}

enum ApprovalStatus {
  REQUESTED
  APPROVED
  DECLINED
  EXPIRED
}

// ───────────── Identity & tenancy ─────────────

model User {
  id                 String        @id @default(cuid())
  type               UserType
  staffRole          StaffRole?
  email              String        @unique
  phone              String?       @unique
  name               String
  passwordHash       String?
  emailVerified      DateTime?
  phoneVerified      DateTime?
  twoFactorSecret    String? // AES-256-GCM encrypted TOTP secret (common/crypto.ts)
  twoFactorEnabledAt DateTime? // set once the first code is confirmed; required for SUPER_ADMIN
  passwordChangedAt  DateTime? // sessions issued before this are rejected
  lastLoginAt        DateTime?
  isActive           Boolean       @default(true) // false = access revoked immediately
  organizationId     String? // null for staff
  organization       Organization? @relation(fields: [organizationId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  managedAssignments ManagerAssignment[] @relation("Manager")
  messages           Message[]
  auditLogs          AuditLog[]

  @@index([organizationId])
}

model Organization {
  id              String    @id @default(cuid())
  legalName       String
  brandName       String?
  gstin           String?
  pan             String?
  category        String?
  contactEmail    String
  contactPhone    String
  address         String?
  city            String?
  pincode         String?
  stateCode       String? // GST state code for place of supply (derived from GSTIN when present)
  isSuspended     Boolean   @default(false)
  suspendedReason String?
  onboardedAt     DateTime? // business + marketplace details + documents complete
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users               User[]
  subscriptions       Subscription[]
  marketplaceAccounts MarketplaceAccount[]
  products            Product[]
  listingRequests     ListingRequest[]
  catalogMappings     CatalogMapping[]
  adCampaigns         AdCampaign[]
  promotionRequests   PromotionRequest[]
  inventoryRecords    InventoryRecord[]
  labelJobs           LabelJob[]
  thankYouTemplates   ThankYouTemplate[]
  marketplaceMonths   MarketplaceMonth[]
  skuMonthLines       SkuMonthLine[]
  productCosts        ProductCost[]
  operatingExpenses   OperatingExpense[]
  reportMonths        ReportMonth[]
  monthlyReports      MonthlyReport[]
  conversations       Conversation[]
  supportTickets      SupportTicket[]
  tasks               Task[]
  serviceRequests     ServiceRequest[]
  managerAssignments  ManagerAssignment[]
  payments            Payment[]
  invoices            Invoice[]
  documents           Document[]
  notifications       Notification[]
  usageCounters       UsageCounter[]
}

// ───────────── Plans (admin-configurable) ─────────────

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique // RESELLER | GROWTH | PREMIUM
  name          String
  pricePaise    Int // 199900, 499900, 999900
  interval      String         @default("monthly")
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  features      PlanFeature[]
  subscriptions Subscription[]
}

/// One row per feature per plan. enabled=false blocks access.
/// limitValue: null = unlimited (fair use), number = cap per billing period.
model PlanFeature {
  id         String  @id @default(cuid())
  planId     String
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String // see packages/permissions/src/features.ts
  enabled    Boolean @default(true)
  limitValue Int?
  meta       Json? // e.g. { callSupport: "ON_REQUEST" | "PRIORITY" }

  @@unique([planId, featureKey])
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(PENDING_PAYMENT)
  razorpaySubId      String?            @unique
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceUntil         DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  termsVersion       String? // Terms & Conditions version the client accepted for this purchase
  termsAcceptedAt    DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([organizationId, status])
}

/// Metered usage per billing period, e.g. NEW_LISTING_AMAZON = 2.
model UsageCounter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  featureKey     String
  periodStart    DateTime
  used           Int          @default(0)

  @@unique([organizationId, featureKey, periodStart])
}

model Payment {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id])
  subscriptionId    String?
  amountPaise       Int // total charged = taxable + GST
  taxablePaise      Int           @default(0)
  taxPaise          Int           @default(0)
  placeOfSupply     String? // GST state code
  status            PaymentStatus @default(INITIATED)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  failureReason     String?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@index([organizationId])
}

/// GST tax invoice (CGST Rule 46). Supplier and buyer details are snapshotted at issue time.
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  paymentId      String?      @unique
  number         String       @unique // SOL/26-27/00001
  financialYear  String       @default("")
  sequence       Int          @default(0)
  sac            String       @default("")
  description    String       @default("")
  periodStart    DateTime?
  periodEnd      DateTime?
  placeOfSupply  String       @default("")
  intraState     Boolean      @default(false)
  gstRateBps     Int          @default(1800)
  taxablePaise   Int          @default(0)
  cgstPaise      Int          @default(0)
  sgstPaise      Int          @default(0)
  igstPaise      Int          @default(0)
  gstPaise       Int // total tax
  amountPaise    Int // invoice total
  supplier       Json?
  buyer          Json?
  fileKey        String?
  issuedAt       DateTime     @default(now())

  @@unique([financialYear, sequence])
  @@index([organizationId])
}

// ───────────── Marketplaces ─────────────

model MarketplaceAccount {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  marketplace    Marketplace
  sellerId       String?
  storeName      String?
  status         String                 @default("PENDING") // PENDING | CONNECTED | ERROR | DISCONNECTED — CONNECTED only with staff-verified evidence
  hasAccount     Boolean                @default(true) // false = client needs seller-account registration
  contactEmail   String? // seller-central login email (never the password)
  verifiedNote   String? // how SOLLUNA verified access (e.g. "user permission accepted in Seller Central")
  verifiedById   String?
  updatedAt      DateTime               @default(now()) @updatedAt
  lastSyncAt     DateTime?
  lastError      String?
  credential     MarketplaceCredential?

  @@unique([organizationId, marketplace])
}

/// OAuth tokens only, AES-256-GCM encrypted. Never passwords.
model MarketplaceCredential {
  id                    String             @id @default(cuid())
  marketplaceAccountId  String             @unique
  marketplaceAccount    MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  encryptedRefreshToken String
  encryptedAccessToken  String?
  accessTokenExpiresAt  DateTime?
  keyVersion            Int                @default(1)
  updatedAt             DateTime           @updatedAt
}

// ───────────── Catalog & listings ─────────────

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  brand          String?
  category       String?
  sku            String?
  hsn            String?
  gstRate        Decimal?     @db.Decimal(5, 2)
  mrpPaise       Int?
  sellingPaise   Int?
  costPaise      Int? // COGS — required for verified P&L
  specs          Json?
  variations     Json?
  asin           String?
  fsn            String?
  createdAt      DateTime     @default(now())

  listingRequests ListingRequest[]
  inventory       InventoryRecord[]

  @@index([organizationId])
}

/// One row per marketplace — Amazon & Flipkart statuses tracked separately.
model ListingRequest {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id])
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  marketplace       Marketplace
  status            ListingStatus @default(RESEARCH_NOT_STARTED)
  countsTowardQuota Boolean       @default(false) // true only once catalog ID created (rejected drafts don't count)
  assigneeId        String?
  payload           Json // title, bullets, description, keywords, attributes
  imageKeys         String[]
  rejectionNote     String?
  liveUrl           String?
  catalogId         String? // ASIN / FSN once created
  serviceRequestId  String? // orchestrator request this listing belongs to
  history           Json          @default("[]") // [{status, note, at, by}]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, marketplace, status])
}

model CatalogMapping {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id])
  marketplace      Marketplace
  identifier       String // ASIN / FSN / product reference
  productInfo      Json?
  status           MappingStatus @default(NOT_ASSESSED) // HIGH_CONFIDENCE needs human review before upload
  candidateId      String? // ASIN / FSN found
  result           Json?
  sellerSku        String?
  note             String?
  assigneeId       String?
  serviceRequestId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([organizationId, status])
}

// ───────────── Ads, promotions, inventory ─────────────

model AdCampaign {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id])
  marketplace      Marketplace
  externalId       String?
  name             String
  dailyBudgetPaise Int?
  status           String        @default("DRAFT")
  metrics          Json? // spend, sales, acos, roas, impressions, clicks
  changes          AdChangeLog[]
  createdAt        DateTime      @default(now())

  @@index([organizationId])
}

model AdChangeLog {
  id            String     @id @default(cuid())
  campaignId    String
  campaign      AdCampaign @relation(fields: [campaignId], references: [id])
  field         String
  previousValue String?
  newValue      String?
  actorId       String? // null = system
  actorType     String // STAFF | SYSTEM
  createdAt     DateTime   @default(now())
}

model PromotionRequest {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  marketplace    Marketplace
  type           String // DEAL | COUPON | LIGHTNING | OTHER
  details        Json
  status         PromotionStatus @default(OPPORTUNITY_IDENTIFIED) // ACTIVE/OPTED_OUT only on marketplace confirmation
  approvalId     String?
  createdAt      DateTime        @default(now())

  @@index([organizationId])
}

model InventoryRecord {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  marketplace    Marketplace
  sku            String         @default("")
  quantity       Int // sellable units
  inboundUnits   Int?
  avgDailySales  Decimal?       @db.Decimal(10, 2) // units/day over the chosen window
  daysOfCover    Decimal?       @db.Decimal(8, 2)
  severity       StockSeverity? // defaults: CRITICAL ≤3d, HIGH 4–7, MEDIUM 8–14, WATCH 15–30
  snapshotId     String         @default("")
  dataAsOf       DateTime       @default(now())
  acknowledgedAt DateTime?
  recordedById   String?
  recordedAt     DateTime       @default(now())

  @@index([organizationId, productId])
}

// ───────────── Labels & Thank You Notes ─────────────

model LabelJob {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  batchDate       DateTime
  marketplace     Marketplace
  status          LabelJobStatus @default(QUEUED)
  orderCount      Int            @default(0)
  skippedOrders   Json? // duplicates, cancellations, invalid
  labelFileKey    String?
  noteFileKey     String? // Premium only
  labelDocumentId String? // official marketplace label PDF, stored unaltered
  noteTemplateId  String? // Premium: approved thank-you template printed as separate inserts
  noteCount       Int            @default(0)
  dispatchBy      DateTime?
  note            String?
  createdById     String?
  startedAt       DateTime?
  completedAt     DateTime?
  downloadedAt    DateTime?

  @@index([organizationId, batchDate])
}

model ThankYouTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  logoKey        String?
  brandName      String
  message        String
  colors         Json
  qrUrl          String?
  widthMm        Int          @default(100)
  heightMm       Int          @default(150)
  approvedAt     DateTime?
  isActive       Boolean      @default(true)
  name           String       @default("Thank you note")
  version        Int          @default(1)
  status         String       @default("DRAFT") // DRAFT | CLIENT_REVIEW | APPROVED | REVISION_REQUESTED | ARCHIVED
  supportContact String?
  approvedById   String?
  revisionNote   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([organizationId, status])
}

// ───────────── Reports & documents ─────────────

/// A client file (business documents, deliverables, chat attachments). Bytes live in storage (fileKey).
model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  kind           String // GST_CERT | PAN | INVOICE | BRAND_AUTH | STATEMENT | REPORT | CA_DOCUMENT | LABELS | CHAT_ATTACHMENT | OTHER
  title          String       @default("")
  fileName       String       @default("")
  visibility     String       @default("CLIENT") // CLIENT (client + staff) | INTERNAL (SOLLUNA staff only)
  fileKey        String // storage key
  sha256         String       @default("")
  mimeType       String // detected from content, not the file name
  sizeBytes      Int
  scanStatus     String       @default("NOT_SCANNED") // NOT_SCANNED | CLEAN | INFECTED
  uploadedById   String
  messageId      String?
  message        Message?     @relation(fields: [messageId], references: [id])
  periodMonth    DateTime? // accounting month the document belongs to (CA pack)
  caStatus       String? // ca-documentation-support §8: VERIFIED_READABLE | DUPLICATE | INCOMPLETE | OUTSIDE_PERIOD | CA_REVIEW_REQUIRED
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, kind])
  @@index([messageId])
}

// ───────────── Chat & support ─────────────

model Conversation {
  id             String       @id @default(cuid())
  organizationId String       @unique // one Manager Chat per customer org
  organization   Organization @relation(fields: [organizationId], references: [id])
  messages       Message[]
  lastMessageAt  DateTime?
  agentPaused    Boolean      @default(false) // ops took over: the manager agent stays quiet
  createdAt      DateTime     @default(now())
}

/// Database-backed object storage for the MVP (swap for S3/R2 behind StorageService).
model FileBlob {
  id        String   @id @default(cuid())
  data      Bytes
  createdAt DateTime @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  senderType     UserType     @default(CUSTOMER)
  body           String
  attachmentKeys String[]
  attachments    Document[]
  isInternalNote Boolean      @default(false) // staff-only, never sent to customer
  byAgent        Boolean      @default(false) // written by the client's manager agent (staff-only flag, never shown to the client)
  readAt         DateTime? // set when the other side (client ↔ SOLLUNA) reads it
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model SupportTicket {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  number          Int             @default(autoincrement())
  category        TicketCategory
  marketplace     Marketplace?
  subject         String
  description     String
  status          TicketStatus    @default(NEW)
  priority        Priority        @default(P3) // SLA ack: P1 30m · P2 2 business hrs · P3 1 business day · P4 2 business days
  assigneeId      String?
  createdById     String
  resolvedAt      DateTime?
  firstResponseAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  comments        TicketComment[]

  @@index([organizationId, status])
  @@index([assigneeId, status])
}

model TicketComment {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  authorType String // CUSTOMER | STAFF | SYSTEM
  authorName String        @default("")
  body       String
  internal   Boolean       @default(false) // staff-only note
  statusFrom TicketStatus?
  statusTo   TicketStatus?
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}

/// Single-use tokens for password reset and email verification. Only the SHA-256 hash is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String // RESET_PASSWORD | VERIFY_EMAIL
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

/// Public website contact form.
model ContactInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  business    String?
  topic       String   @default("GENERAL") // GENERAL | PLANS | SUPPORT | PARTNERSHIP
  message     String
  status      String   @default("NEW") // NEW | CONTACTED | CONVERTED | CLOSED
  handledById String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

/// A client request as received by the orchestrator (Step 1). Expands into one or more Tasks.
model ServiceRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  featureKey     String
  workflow       String // workflow template id (orchestrator Step 4)
  marketplace    Marketplace?
  title          String
  details        Json
  status         TaskStatus   @default(NEW)
  entitlement    String // ALLOWED | PENDING_VERIFICATION | OUT_OF_PLAN | LIMIT_REACHED
  createdById    String
  tasks          Task[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

/// Orchestrator work item (solluna-skill-orchestrator Step 5). One per routed skill action.
model Task {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  requestId      String?
  request        ServiceRequest? @relation(fields: [requestId], references: [id])
  stepKey        String? // workflow step id
  stepIndex      Int             @default(0) // position in the workflow (createdAt is identical within one transaction)
  approvalAction String? // if set, client Approval of this action type gates the task
  title          String
  featureKey     String // packages/permissions FEATURES key
  skill          String // .claude/skills/<skill>
  marketplace    Marketplace?
  priority       Priority        @default(P3)
  status         TaskStatus      @default(NEW)
  entitlement    String          @default("PENDING_VERIFICATION") // ALLOWED | PENDING_VERIFICATION | OUT_OF_PLAN | LIMIT_REACHED
  requiredInputs Json?
  dependsOnIds   String[]
  refId          String? // linked listing/mapping/label/promo id
  assigneeId     String?
  dueAt          DateTime?
  evidence       Json? // output locations, marketplace confirmations
  blocker        String?
  approvals      Approval[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([assigneeId, status])
}

/// Explicit, action-specific client approval (orchestrator "Approval and authorization rules").
/// Required before: ad budget changes, spend, fees, price/offer changes, material content changes,
/// consequential order actions, third-party data sharing, out-of-plan work.
model Approval {
  id             String         @id @default(cuid())
  organizationId String
  taskId         String?
  task           Task?          @relation(fields: [taskId], references: [id])
  actionType     String // AD_BUDGET | SPEND | MARKETPLACE_FEE | PRICE_CHANGE | CONTENT_CHANGE | ORDER_ACTION | DATA_SHARE | OUT_OF_PLAN
  parameters     Json // the material parameters approved (amount, SKU, dates…)
  status         ApprovalStatus @default(REQUESTED)
  requestedById  String
  decidedById    String? // client user
  decidedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([organizationId, status])
}

/// seller-account-registration §7 — per marketplace.
model MarketplaceRegistration {
  id                 String      @id @default(cuid())
  organizationId     String
  marketplace        Marketplace
  registrationStatus String      @default("not_started")
  verificationStatus String      @default("not_started")
  accountStatus      String      @default("unknown")
  launchStatus       String      @default("not_assessed")
  consentStatus      String      @default("pending")
  locations          Json?
  updatedAt          DateTime    @updatedAt

  @@unique([organizationId, marketplace])
}

/// brand-approval-assistance — classify approval type before acting.
model BrandApproval {
  id                 String      @id @default(cuid())
  organizationId     String
  marketplace        Marketplace
  brand              String
  approvalType       String // reseller_selling_approval | catalog_brand_creation | brand_owner_enrollment | product_category_approval
  clientRelationship String // brand_owner | manufacturer | authorized_distributor | authorized_reseller | importer
  status             String      @default("intake")
  evidence           Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([organizationId])
}

model ManagerAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  managerId      String
  manager        User         @relation("Manager", fields: [managerId], references: [id])
  isPrimary      Boolean      @default(true)
  assignedAt     DateTime     @default(now())
  endedAt        DateTime?

  @@index([managerId])
  @@index([organizationId])
}

// ───────────── Notifications & audit ─────────────

model Notification {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId         String?
  type           String
  title          String
  body           String
  channel        String        @default("IN_APP") // IN_APP | EMAIL | SMS | WHATSAPP
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id])
  actorType      String // CUSTOMER | STAFF | SYSTEM
  organizationId String?
  action         String // e.g. subscription.activate, credential.update
  entity         String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

// ───────────── Monthly reporting (skills: monthly-business-performance-report, monthly-pl-report, ca-documentation-support) ─────────────

/// Monthly marketplace figures entered by SOLLUNA from marketplace reports (manual-assisted until APIs are approved).
/// All amounts in paise, GST-exclusive. NULL = not provided (never treated as zero).
model MarketplaceMonth {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  periodMonth         DateTime // first day of the month (UTC)
  marketplace         Marketplace
  salesBasis          String       @default("SHIPPED") // SHIPPED | ORDERED — never mixed
  grossSalesPaise     Int?
  discountsPaise      Int?
  returnsRefundsPaise Int?
  reimbursementsPaise Int?
  orders              Int?
  unitsSold           Int?
  unitsReturned       Int?
  cancelledOrders     Int?
  sessions            Int?
  commissionPaise     Int?
  fixedFeesPaise      Int?
  fulfilmentPaise     Int?
  shippingPaise       Int?
  storagePaise        Int?
  otherFeesPaise      Int?
  adSpendPaise        Int?
  adSalesPaise        Int?
  impressions         Int?
  clicks              Int?
  adSpendInFees       Boolean      @default(false) // ad spend already deducted inside marketplace fees (avoid double count)
  settlementPaise     Int?
  bankCreditPaise     Int? // verified bank credit for the settlement
  reservesPaise       Int?
  sourceNote          String? // which reports were used
  enteredById         String
  updatedAt           DateTime     @updatedAt

  @@unique([organizationId, periodMonth, marketplace])
}

/// SKU-level lines for product-wise profitability.
model SkuMonthLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  periodMonth    DateTime
  marketplace    Marketplace
  sku            String
  units          Int
  netSalesPaise  Int
  feesPaise      Int?
  adSpendPaise   Int?

  @@unique([organizationId, periodMonth, marketplace, sku])
}

/// Landed cost per unit (purchase + inbound freight + packaging + prep), effective-dated.
model ProductCost {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  sku             String
  costPaise       Int
  includesGst     Boolean      @default(false)
  effectiveFrom   DateTime
  clientConfirmed Boolean      @default(false) // true when entered/confirmed by the client
  enteredById     String
  createdAt       DateTime     @default(now())

  @@index([organizationId, sku, effectiveFrom])
}

model OperatingExpense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  periodMonth    DateTime
  category       String // STAFF | RENT | SOFTWARE | PROFESSIONAL | TRANSPORT | OTHER
  description    String
  amountPaise    Int
  documentId     String? // supporting invoice
  enteredById    String
  createdAt      DateTime     @default(now())

  @@index([organizationId, periodMonth])
}

/// Per-month client confirmations.
model ReportMonth {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  periodMonth       DateTime
  expensesConfirmed Boolean      @default(false)
  confirmedById     String?
  confirmedAt       DateTime?

  @@unique([organizationId, periodMonth])
}

/// Immutable generated report snapshot. Clients only see PUBLISHED versions.
model MonthlyReport {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  periodMonth    DateTime
  kind           String // PERFORMANCE | PL
  version        Int
  status         String           @default("DRAFT") // DRAFT | PUBLISHED | SUPERSEDED
  confidence     FigureConfidence
  data           Json
  generatedById  String
  publishedById  String?
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())

  @@unique([organizationId, periodMonth, kind, version])
  @@index([organizationId, status])
}

/// Manager hand-off after a plan starts: the client is promised a manager within 1 hour; the manager is assigned
/// after MANAGER_ASSIGN_DELAY_MIN and sends a few short messages, one step at a time (chat.service.ts).
model ManagerWelcome {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  planCode         String
  previousPlanCode String?
  kind             String // NEW | CHANGE
  preview          Boolean  @default(false)
  step             Int      @default(0)
  dueAt            DateTime
  createdAt        DateTime @default(now())

  @@index([dueAt])
}

/// Self-serve label cropping (LABEL_CROPPER). Auto / specialised crops run in the background processor, never in the
/// request. The uploaded source (buyer addresses) is deleted as soon as the job finishes; outputs expire after 7 days.
model LabelCropJob {
  id                String    @id @default(cuid())
  organizationId    String
  createdById       String
  mode              String // AUTO | SPECIAL
  layout            String // A4_4UP | A4_6UP | THERMAL_4X6
  includeInvoices   Boolean   @default(false)
  fileName          String
  sourceKey         String?
  outputKey         String?
  status            String    @default("QUEUED") // QUEUED | PROCESSING | DONE | FAILED
  marketplace       String?
  labelCount        Int       @default(0)
  invoiceCount      Int       @default(0)
  unrecognisedPages Int[]
  reviewPages       Int[]
  error             String?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  expiresAt         DateTime

  @@index([organizationId, createdAt])
  @@index([status])
}

/// A listing / mapping request submitted through the Listings & Mapping forms (packages/catalog-forms).
model CatalogForm {
  id             String   @id @default(cuid())
  organizationId String
  marketplace    String // FLIPKART | AMAZON
  kind           String // MAPPING | NEW_LISTING
  title          String
  data           Json
  requestId      String?
  createdById    String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

/// Saved form values a client can start the next similar listing from (same product family, MOQ, combo …).
model CatalogTemplate {
  id             String   @id @default(cuid())
  organizationId String
  marketplace    String
  kind           String
  name           String
  data           Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, marketplace, kind, name])
}

/// Online product-details lookup for the Listings & Mapping forms (Claude web search). Runs in the background
/// processor; results only pre-fill empty form fields and are always checked by the client before submitting.
model ProductLookup {
  id             String    @id @default(cuid())
  organizationId String
  createdById    String
  marketplace    String
  kind           String
  link           String
  ref            String? // ASIN / FSN or normalised link, used to reuse a recent result
  status         String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED
  result         Json?
  sources        Json?
  notes          String?
  error          String?
  cached         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([organizationId, createdAt])
  @@index([status])
  @@index([marketplace, ref])
}

/// Client manager agent: what it remembers about one client. Only ever loaded for that client.
model AgentMemory {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([organizationId, key])
}

/// One manager-agent reply: queue entry + token usage and estimated cost (for watching spend per client).
model AgentRun {
  id               String    @id @default(cuid())
  organizationId   String
  status           String    @default("QUEUED") // QUEUED | RUNNING | DONE | SKIPPED | FAILED
  model            String    @default("")
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  cacheReadTokens  Int       @default(0)
  cacheWriteTokens Int       @default(0)
  costMicroUsd     Int       @default(0)
  toolCalls        Int       @default(0)
  replyMessages    Int       @default(0)
  trace            Json? // observability: input flags, guardrail results, tools used, latency, skills retrieved
  note             String?
  dueAt            DateTime  @default(now())
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([status, dueAt])
  @@index([organizationId, createdAt])
}

/// Manager-agent quality check: one run of the eval set (apps/api/evals) on the server.
model EvalRun {
  id           String    @id @default(cuid())
  status       String    @default("RUNNING") // RUNNING | DONE | FAILED
  model        String?
  score        Float?
  passed       Int?
  total        Int?
  costMicroUsd Int       @default(0)
  report       Json?
  error        String?
  startedById  String
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([createdAt])
}
